{ // Preset-File for fb_tools: {charset:ascii, tabs:8, lines:lf, lang:de}

 preset: { // Preset begin	(Fritz!Box Zugangsdaten - Die Keys in "preset" sind frei waehlbar)
	// # Example begin
	fbstd:   "http://192.168.178.1",	// Standart-IP (Kurzform)				# "fb_tools fbstd boxinfo"
	fbata:   {host: "192.168.188.1"},	// Standart-IP (ATA-Modus)				# "fb_tools fbata boxinfo"
	notfall: {host: "169.254.1.1"},		// ZeroConf-IP (Ohne DHCP)				# "fb_tools notfall boxinfo"
	beispiel:{host: "fritz.box", pass: "\61\62\63\64\65"},	// Klassisch nur Kennwort (12345)	# "fb_tools beispiel logintest"
	myfritz: {	sock: "https",				// Verbindung per Fernwartung		# "fb_tools myfritz logintest"
			host: "0123456789abcdef.myfritz.net",	// DynDNS oder MyFRITZ!-Domain
			port: 65443,				// Port der Fritz!Box fuer die Fernwartung
			user: "admin",				// Benutzername mit Fernwartungsrecht
			pass: "admin123",			// Kennwort
			uipw: "GOOG LETW OFAC TORA UTHE NTIC ATIO NOTP"}, // Google Authenticator Geheimnis
	shorty: "https://admin:admin123@0123456789abcdef.myfritz.net:65443#GOOGLETWOFACTORAUTHENTICATIONOTP",	// Einzeiler von "myfritz"
	"7456": "http://SessionID@home.mengelke.de:8080",	// Fritz!Box Anmeldesimulator v1	"fb_tools 7456 logintest"
	"7500": "http://SessionID@home.mengelke.de",		// Fritz!Box Anmeldesimulator v2	"fb_tools 7500 logintest"
	// # Example end

#	// Example begin (Auskommentiert)
#	meinebox: {
#		sock: "http",		// -p:	Protokoll (auto, http, https, ssl, tls)
#		host: "fritz.nas",	// -fb:	IP/DNS-Adresse der Fritz!Box
#		port: 80,		// -pt:	Port (http -> 80, https -> 443)
#		user: "max",		// -un:	Benutzername (Oder auch false, bei automatisch erstellter Benutzer - z.B. fritz1337)
#		pass: "password",	// -pw:	Kennwort
#		uipw: "",		// -ui:	OS4 Anmelde-Kennwort bei Fernwartung ODER Ab OS6.80+ Zwei-Faktor-Authentisierung (NUR wenn erforderlich)
#		totp: "",		// -tf:	OS6.80+ Zwei-Faktor-Authentisierung bei Login (ABCD EFGH IJKL MNOP QRST UVWX YZ23 4567)
#		livs: 0,		// -li:	Login-Version (0 -> Auto, 1 -> MD5, 2 -> PBKDF2)
#	},
#	// Example end (Auskommentiert)
 },	// Preset end



 drag:	{ // Drag'n'Drop-Modus begin (Was passieren soll, wenn fb_Tools mit einer Datei per Drag'n'Drop gestartet wurde - Die Keys sind Extension)
	"*":	"info hash *",		// Fuer Unbekannte Dateitypen
	csv:	"info csv *",		// Texttabellen
	txt:	"info cat *",		// Plaintext
	json: 	"info json *",		// Text-Daten
	tar:	"info extrakt *",	// Archiv (TAR)
	tbz:	"info extrakt *",	// Archiv (TAR & BZip2)
	tgz:	"info extrakt *",	// Archiv (TAR & GZip)
	zip:	"info extrakt *",	// Archiv (ZIP)
	export:	"konfig fcs * -d",	// Fritz!Box-Konfig Dateien
 },	// Drag'n'Drop-Modus end



